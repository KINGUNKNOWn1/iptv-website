# Stream Holland - Environment Variables
# Copy this file to .env.local for local development
# Copy this file to .env.production for production deployment

# =============================================================================
# ANALYTICS & TRACKING
# =============================================================================

# Google Analytics 4 (GA4)
# Get your Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager (Optional)
# Get your GTM ID from: https://tagmanager.google.com/
# Format: GTM-XXXXXXX
VITE_GTM_ID=GTM-XXXXXXX

# Facebook Pixel (Optional - for marketing cookies)
# Get your Pixel ID from: https://business.facebook.com/
VITE_FACEBOOK_PIXEL_ID=

# =============================================================================
# CONTACT INFORMATION
# =============================================================================

# WhatsApp Business Number
# Format: International format without + (e.g., 31612345678)
# Used in: Footer, Contact page, WhatsApp CTA button
VITE_WHATSAPP_NUMBER=31612345678

# Support Email
# Used for: Customer support, contact forms
VITE_SUPPORT_EMAIL=support@streamholland.com

# General Info Email
# Used for: General inquiries
VITE_INFO_EMAIL=info@streamholland.com

# Privacy/GDPR Email
# Used for: Privacy requests, GDPR compliance
VITE_PRIVACY_EMAIL=privacy@streamholland.com

# =============================================================================
# DOMAIN & SEO
# =============================================================================

# Production Domain (without https://)
# Used for: sitemap.xml, robots.txt, canonical URLs
VITE_DOMAIN=streamholland.com

# Site URL (with https://)
# Used for: Open Graph tags, schema.org markup
VITE_SITE_URL=https://streamholland.com

# Google Search Console Verification Code
# Get from: https://search.google.com/search-console
VITE_GOOGLE_VERIFICATION=your-verification-code-here

# =============================================================================
# EMAIL SERVICE (Optional - for Contact Form)
# =============================================================================

# EmailJS Configuration
# Get your keys from: https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# OR use SendGrid
# Get your API key from: https://sendgrid.com/
VITE_SENDGRID_API_KEY=

# OR use Resend
# Get your API key from: https://resend.com/
VITE_RESEND_API_KEY=

# =============================================================================
# PAYMENT INTEGRATION (Optional - if selling subscriptions)
# =============================================================================

# Stripe
# Get your keys from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...  # Server-side only, NOT prefixed with VITE_

# Mollie (Popular in Netherlands)
# Get your keys from: https://www.mollie.com/dashboard/
VITE_MOLLIE_API_KEY=

# =============================================================================
# BACKEND API (Optional - if you have a backend)
# =============================================================================

# API Base URL
VITE_API_URL=https://api.streamholland.com
VITE_API_KEY=

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features
VITE_ENABLE_COOKIE_CONSENT=true
VITE_ENABLE_WEB_VITALS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_THREE_JS=true

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Development mode (automatically set by Vite)
# DEV=true or DEV=false

# =============================================================================
# NOTES
# =============================================================================
#
# 1. VITE_ prefix is REQUIRED for environment variables to be exposed to the client
# 2. Never commit .env.local or .env.production to git (they're in .gitignore)
# 3. Update index.html with your GA4 ID and verification code
# 4. Run npm run dev to test locally with .env.local
# 5. Deploy to Vercel/Netlify and set environment variables in dashboard
#
# =============================================================================
